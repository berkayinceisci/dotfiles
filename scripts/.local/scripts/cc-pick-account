#!/usr/bin/env bash
# Launch Claude Code under whichever BUSINESS (moatlab) account has the most
# quota headroom left.
#
# The moatlab accounts are interchangeable capacity, not separate identities:
# bootstrap.sh symlinks every profile's projects/ and my-session-logs/ into
# ~/.claude, so a session started under one account can be resumed under
# another. The only thing that actually differs between them is how much of the
# 5h / 7d rate-limit window each has burned -- which is exactly what this picks.
#
# The PERSONAL account (~/.claude, the `ccp` alias) is deliberately NOT a
# candidate. It is a different identity, not spare capacity; auto-routing
# business work onto it would be a policy decision, not a scheduling one.
#
# Selection: each candidate is scored by its rate-limit percentages sorted
# WORST-FIRST and compared lexicographically -- the binding constraint (worst
# window) decides, and only on a tie does the second-worst window break it,
# then the third. Rationale: any window being exhausted blocks you equally,
# but when both accounts are pinned at the same worst window (e.g. Fable
# 100%/100%), the account with more headroom in its remaining windows is the
# useful one to land on (switch model, keep working). Encoding: percentages
# formatted %06.2f and joined with "," ("100.00,080.00,010.00"), so plain
# string comparison IS the numeric lexicographic comparison. Full ties keep
# the first profile, so the default stays stable. The statusline-cache fast
# path scores on 5h/7d/Fable (statusline.sh's 6-field cache format); the API
# path (the common case) sees every window in limits[].
#
# Usage: cc-pick-account [-v|--verbose] [-n|--dry-run] [--] [claude args...]
#   -v  log each profile's 5h/7d numbers and the launch command to stderr
#   -n  print the account that would be chosen and exit without launching
#   --  stop parsing picker flags; pass everything after it to claude verbatim
#
# Leading flags are consumed by the picker; the first unrecognized argument
# ends flag parsing, so `cc-pick-account --dangerously-skip-permissions` and
# `cc-pick-account --resume <id>` pass through as-is. Use `--` when an argument
# would otherwise collide (e.g. `cc-pick-account -- --verbose` gives claude its
# own --verbose rather than the picker's).

set -euo pipefail

VERBOSE=0
DRY_RUN=0
while [[ $# -gt 0 ]]; do
	case "$1" in
	-v | --verbose)
		VERBOSE=1
		shift
		;;
	-n | --dry-run)
		DRY_RUN=1
		shift
		;;
	--)
		shift
		break
		;;
	*)
		break
		;;
	esac
done

log() {
	if [[ $VERBOSE -eq 1 ]]; then
		echo "cc-pick-account: $*" >&2
	fi
}

# Same cache the statusline writes (statusline.sh: /tmp/claude-usage-cache-<dir>
# holding "<epoch>\n<5h>|<7d>|<5h-reset>|<7d-reset>"). Read-only here: the
# statusline stays the single writer so there is no second definition of the
# format's freshness semantics.
CACHE_TTL=120     # seconds; matches statusline.sh CACHE_TTL
UNKNOWN="|||"     # statusline.sh's "no data" sentinel
CURL_TIMEOUT=4    # per-profile API budget; all profiles are queried in parallel

# --- candidate discovery ----------------------------------------------------
# ~/.claude-moatlab, ~/.claude-moatlab2, ... -- the same set bootstrap.sh
# manages as CLAUDE_SECONDARY_PACKAGES, discovered by glob so a newly added
# profile needs no edit here.
CANDIDATES=()
for dir in "$HOME"/.claude-moatlab*/; do
	if [[ -d "$dir" ]]; then
		CANDIDATES+=("${dir%/}")
	fi
done

if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
	echo "cc-pick-account: no ~/.claude-moatlab* profile found; run bootstrap.sh" >&2
	exit 1
fi

# --- usage lookup -----------------------------------------------------------
# Reads a still-fresh statusline cache entry for a profile, else empty.
# Freshness needs BOTH the TTL and the 5h reset time: an entry from before a
# window rollover is not merely old, it describes a window that no longer
# exists.
read_cache() {
	local cfg="$1" cache_file entry cache_time now five_reset reset_epoch
	cache_file="/tmp/claude-usage-cache-${cfg##*/}"
	if [[ ! -f "$cache_file" ]]; then
		return 1
	fi

	cache_time=$(head -1 "$cache_file" 2>/dev/null || echo 0)
	if [[ ! "$cache_time" =~ ^[0-9]+$ ]]; then
		return 1
	fi
	entry=$(tail -n +2 "$cache_file" 2>/dev/null)
	if [[ -z "$entry" || "$entry" == "$UNKNOWN" ]]; then
		return 1
	fi

	now=$(date +%s)
	if ((now - cache_time >= CACHE_TTL)); then
		return 1
	fi

	# Drop an entry whose 5h window has already rolled over
	five_reset=$(echo "$entry" | cut -d'|' -f3)
	if [[ -n "$five_reset" ]]; then
		if reset_epoch=$(date -d "$five_reset" +%s 2>/dev/null); then
			if ((now >= reset_epoch)); then
				return 1
			fi
		fi
	fi

	# Fields 1-2 are 5h/7d; field 5 is the Fable weekly pct (present since the
	# statusline's 6-field cache format; empty on old 4-field entries). Emit
	# five|seven|key so the cache path scores on every known window.
	local five seven fable
	five=$(echo "$entry" | cut -d'|' -f1)
	seven=$(echo "$entry" | cut -d'|' -f2)
	fable=$(echo "$entry" | cut -d'|' -f5)
	local key
	key=$(awk -v a="$five" -v b="$seven" -v c="${fable:-0}" 'BEGIN {
		n = 3; v[1] = a + 0; v[2] = b + 0; v[3] = c + 0
		for (i = 1; i < n; i++)
			for (j = 1; j <= n - i; j++)
				if (v[j] < v[j+1]) { t = v[j]; v[j] = v[j+1]; v[j+1] = t }
		printf "%06.2f,%06.2f,%06.2f", v[1], v[2], v[3] }')
	echo "$five|$seven|$key"
}

# Queries the usage API for one profile. Linux only: on macOS the OAuth
# credentials live in a SINGLE Keychain entry ("Claude Code-credentials")
# shared by every profile, so there is no per-profile token to authenticate
# with -- see statusline.sh read_creds(). macOS therefore relies on the
# per-profile cache files alone, which is why this returns empty there.
fetch_usage() {
	local cfg="$1" creds_file token response five seven

	if [[ "$OSTYPE" == "darwin"* ]]; then
		return 1
	fi

	creds_file="$cfg/.credentials.json"
	if [[ ! -f "$creds_file" ]]; then
		return 1
	fi
	if ! token=$(jq -r '.claudeAiOauth.accessToken // empty' "$creds_file" 2>/dev/null); then
		return 1
	fi
	if [[ -z "$token" ]]; then
		return 1
	fi

	response=$(curl -s --max-time "$CURL_TIMEOUT" \
		-H "Authorization: Bearer $token" \
		-H "anthropic-beta: oauth-2025-04-20" \
		"https://api.anthropic.com/api/oauth/usage" 2>/dev/null) || return 1

	if [[ -z "$response" ]]; then
		return 1
	fi
	if jq -e '.error' >/dev/null 2>&1 <<<"$response"; then
		return 1
	fi

	five=$(jq -r '.five_hour.utilization // empty' <<<"$response" 2>/dev/null)
	seven=$(jq -r '.seven_day.utilization // empty' <<<"$response" 2>/dev/null)
	if [[ -z "$five" || -z "$seven" ]]; then
		return 1
	fi
	# Scoring key over ALL windows (incl. per-model weeklies like Fable,
	# which five_hour/seven_day alone miss): percents sorted worst-first,
	# fixed-width joined. Empty if the API ever drops limits[]; the caller
	# then falls back to a key built from 5h/7d.
	key=$(jq -r '[.limits[]?.percent] | sort | reverse | join(" ")' <<<"$response" 2>/dev/null)
	if [[ -n "$key" ]]; then
		key=$(awk -v s="$key" 'BEGIN {
			n = split(s, v, " ")
			for (i = 1; i <= n; i++) printf "%s%06.2f", (i > 1 ? "," : ""), v[i] }')
	fi
	echo "$five|$seven|$key"
}

# Cache first (free), API second. Writes "<cfg>|<five>|<seven>|<key>|<src>"
# to $2. Both paths emit three usage fields; the cache path's key covers
# 5h/7d/Fable (all the statusline cache stores), the API path's covers every
# window in limits[].
resolve_usage() {
	local cfg="$1" out="$2" usage
	if usage=$(read_cache "$cfg"); then
		echo "$cfg|$usage|cache" >"$out"
		return 0
	fi
	if usage=$(fetch_usage "$cfg"); then
		echo "$cfg|$usage|api" >"$out"
		return 0
	fi
	echo "$cfg||||unknown" >"$out"
}

if ! command -v jq >/dev/null 2>&1; then
	log "jq not found; cannot read usage, falling back to ${CANDIDATES[0]}"
	CHOSEN="${CANDIDATES[0]}"
else
	# Query every profile concurrently so the launch latency is one API round
	# trip, not one per account.
	WORKDIR=$(mktemp -d)
	trap 'rm -rf "$WORKDIR"' EXIT

	idx=0
	for cfg in "${CANDIDATES[@]}"; do
		resolve_usage "$cfg" "$WORKDIR/$idx" &
		idx=$((idx + 1))
	done
	wait

	# Lowest key wins, compared lexicographically: the worst window decides,
	# ties fall through to the second-worst, then the third (see the Selection
	# note up top). Keys are fixed-width "%06.2f,..." strings, so awk's string
	# comparison IS the numeric lexicographic comparison. Unknown profiles get
	# a key above any real one so they only win when nothing else is known.
	CHOSEN=""
	best=""
	for result_file in "$WORKDIR"/*; do
		# A job that died before writing leaves an empty file; `read` then fails
		# on EOF, which `set -e` would turn into an aborted launch. Skip instead.
		if ! IFS='|' read -r cfg five seven key source <"$result_file"; then
			continue
		fi
		if [[ -z "$cfg" ]]; then
			continue
		fi
		if [[ -n "$five" && -n "$seven" ]]; then
			# No limits[]-derived key (older API without limits[]): fall back
			# to a key over the two windows the top-level fields do give.
			if [[ -z "$key" ]]; then
				key=$(awk -v a="$five" -v b="$seven" 'BEGIN {
					if (a + 0 < b + 0) { t = a; a = b; b = t }
					printf "%06.2f,%06.2f", a, b }')
			fi
			log "$(basename "$cfg"): 5h=${five}% 7d=${seven}% key=${key} ($source)"
		else
			key="999.00"
			log "$(basename "$cfg"): no usage data ($source)"
		fi
		if [[ -z "$best" ]] || awk -v x="$key" -v y="$best" 'BEGIN {exit !(x "" < y "")}'; then
			best="$key"
			CHOSEN="$cfg"
		fi
	done

	if [[ -z "$CHOSEN" ]]; then
		CHOSEN="${CANDIDATES[0]}"
	fi
fi

if [[ $DRY_RUN -eq 1 ]]; then
	echo "$CHOSEN"
	exit 0
fi

log "launching: CLAUDE_CONFIG_DIR=$CHOSEN claude $*"
if [[ $VERBOSE -eq 0 ]]; then
	echo "→ $(basename "$CHOSEN")" >&2
fi

export CLAUDE_CONFIG_DIR="$CHOSEN"
exec claude "$@"
