#!/bin/bash
# dl - Download media from URLs (auto-detects video/image/PDF/text)
#
# Usage: dl <url>           Auto-detect and download
#        dl -o <name> <url> Download video with custom filename
#        dl -t <start-end> <url>
#                           Download a video timeframe. Each timestamp is
#                           [[H:]M:]S, so a bare number means SECONDS: 90, 1:30
#                           and 0:1:30 are the same instant, and 5:6 is 5m6s --
#                           not 5s 600ms. Milliseconds go after a decimal point
#                           instead, which makes cuts millisecond-exact:
#                           5.600 is 5s 600ms. Either side may be left off --
#                           5.600- runs to the end (same as 5.600-inf) and -2
#                           starts at the beginning
#                           (e.g. 10.250-12.750, 1:23.456-1:25.25, 0:02.5-0:04)
#        dl --max <url>     Download the best resolution available, instead of
#                           the default 1080p cap
#        dl -f <url>        Overwrite existing files without asking
#        dl -n <url>        Skip files that already exist (do not overwrite)
#        dl --extractor-args <args> <url>
#                           Pass extractor args straight through to yt-dlp
#                           (e.g. youtube:player_client=web_embedded)

set -euo pipefail

print_usage() {
    echo "Usage: dl <url>           Download (auto-detect video/image/PDF/text)"
    echo "       dl -o <name> <url> Download video with custom filename"
    echo "       dl -t <start-end> <url> Download a video timeframe"
    echo "                          Timestamps are [[H:]M:]S, so a bare number is"
    echo "                          seconds (90 = 1:30 = 0:1:30). Milliseconds go"
    echo "                          after a decimal point, not another colon:"
    echo "                          5.600 is 5s 600ms, while 5:6 is 5m 6s."
    echo "                          Omit either side: 5.600- (= 5.600-inf) runs to"
    echo "                          the end, -2 starts at the beginning."
    echo "                          e.g. 10.250-12.750, 1:23.456-1:25.25, 0:02.5-0:04"
    echo "       dl --max <url>     Best resolution available (default: 1080p cap)"
    echo "       dl -f <url>        Overwrite existing files without asking"
    echo "       dl -n <url>        Skip files that already exist"
    echo "       dl --extractor-args <args> <url> Pass extractor args to yt-dlp"
}

require_ytdlp() {
    if ! command -v yt-dlp >/dev/null 2>&1; then
        echo "Error: yt-dlp not found" >&2
        exit 1
    fi
}

# macOS stat is BSD, Linux stat is GNU -- incompatible flags for both queries
file_size() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        stat -f%z "$1"
    else
        stat -c%s "$1"
    fi
}

file_mtime() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$1"
    else
        stat -c '%y' "$1" | cut -d. -f1
    fi
}

human_size() {
    numfmt --to=iec "$1" 2>/dev/null || echo "$1 bytes"
}

cleanup_staging() {
    if [[ -n "$staging" && -d "$staging" ]]; then
        rm -rf "$staging"
    fi
}

# yt-dlp skips a download whose target already exists, so an attempt that runs
# after a failed one must not inherit what the failed one left behind
reset_staging() {
    if [[ -n "$staging" && -d "$staging" ]]; then
        find "$staging" -mindepth 1 -delete
    fi
}

# Ask before destroying an existing file. The answer is read from the terminal
# rather than stdin, so the filepath this script prints on stdout stays pipeable.
# Returns 0 to overwrite, 1 to keep what is already there.
confirm_overwrite() {
    local target="$1"
    local reply=""

    # No controlling terminal (piped, cron, another script): refuse rather than
    # guess, since either guess silently does the wrong thing to real data
    if ! { : >/dev/tty; } 2>/dev/null; then
        echo "Error: $target already exists and there is no terminal to ask." >&2
        echo "       Pass -f to overwrite it or -n to skip it." >&2
        cleanup_staging
        exit 1
    fi

    printf '%s exists (%s, modified %s). Overwrite? [y/N/a] ' \
        "$target" "$(human_size "$(file_size "$target")")" "$(file_mtime "$target")" >/dev/tty
    read -r reply </dev/tty || reply=""
    case "$reply" in
        [yY]) return 0 ;;
        [aA]) overwrite_all=1; return 0 ;;  # rest of this run, e.g. a gallery
        *)    return 1 ;;
    esac
}

# The single place a download is allowed to replace something already on disk.
# Every backend routes through here: curl overwrites silently and yt-dlp instead
# skips silently, so leaving the decision to either one gives two different
# behaviours for the same collision. Returns 1 when the file was not installed.
install_staged() {
    local staged="$1"
    local target="$2"

    if [[ -e "$target" ]]; then
        if [[ $no_clobber -eq 1 ]]; then
            echo "-> $target exists, skipping" >&2
            return 1
        fi
        if [[ $force -eq 0 && $overwrite_all -eq 0 ]]; then
            if ! confirm_overwrite "$target"; then
                echo "-> kept existing $target" >&2
                return 1
            fi
        fi
    fi

    if ! mv -f "$staged" "$target"; then
        echo "Error: failed to install $target" >&2
        cleanup_staging
        exit 1
    fi
}

download_video() {
    local url="$1"
    local name="${2:-}"
    require_ytdlp
    local -a extra_args=()
    if [[ -n "$name" ]]; then
        extra_args+=(--output "${name}.%(ext)s")
    fi
    if [[ -n "$timeframe" ]]; then
        # A section cut is downloaded by ffmpeg, and --print puts yt-dlp in quiet
        # mode, which it forwards as -loglevel quiet -- so ffmpeg's account of why
        # a cut failed is discarded and only "ffmpeg exited with code N" survives.
        # A later -loglevel wins, so this restores ffmpeg's diagnostics on stderr
        # (where download_platform reads them) without touching the stdout parsed
        # for the filepath.
        extra_args+=(--download-sections "*$timeframe" --force-keyframes-at-cuts
                     --downloader-args "ffmpeg:-loglevel error")
    fi
    if [[ -n "$extractor_args" ]]; then
        extra_args+=(--extractor-args "$extractor_args")
    fi
    # Cap the resolution unless --max asked for whatever the source has. yt-dlp
    # computes res as min(width, height), so one cap reads correctly in both
    # orientations -- a 1080x1920 portrait clip counts as 1080, where a
    # [height<=1080] filter would have rejected it and left only a 426x760
    # rendition. ":" sets a limit rather than a hard filter: formats at or below
    # the cap rank first (largest first), those above it only afterwards
    # (smallest first), so a source with nothing under the cap still downloads
    # instead of matching no format at all.
    if [[ -n "$max_res" ]]; then
        extra_args+=(-S "res:$max_res")
    fi
    local filepath rc=0
    filepath=$(yt-dlp --format "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]" -I 1 -P "$staging" ${extra_args[@]+"${extra_args[@]}"} --print after_move:filepath "$url") || rc=$?
    if [[ $rc -ne 0 ]]; then
        return $rc
    fi
    local target
    target=$(basename "$filepath")
    if install_staged "$filepath" "$target"; then
        echo "$PWD/$target"
        if [[ -f "$target" ]]; then
            echo "Size: $(human_size "$(file_size "$target")")"
        fi
    fi
}

# yt-dlp fallback for platform image posts (Instagram image posts, etc.)
download_platform_image() {
    local url="$1"
    local name="${2:-}"
    require_ytdlp
    local -a extra_args=()
    if [[ -n "$name" ]]; then
        extra_args+=(--output "${name}.%(ext)s")
    fi
    local filepath
    filepath=$(yt-dlp -P "$staging" ${extra_args[@]+"${extra_args[@]}"} --print after_move:filepath "$url")
    local target
    target=$(basename "$filepath")
    if install_staged "$filepath" "$target"; then
        echo "$PWD/$target"
    fi
}

# Twitter/X media posts: yt-dlp's twitter extractor now fails on many tweets
# (X requires auth), so use fxtwitter's public JSON API to extract media URLs
# (both photos and videos), then curl each one
download_twitter_media() {
    local url="$1"
    local name="${2:-}"
    local api_url
    # Media permalinks (.../status/123/photo/2, .../status/123/video/1) are valid
    # on x.com but 404 on the API, which only knows the bare status URL -- strip
    # that suffix, plus any query/fragment, before rewriting the host
    api_url=$(echo "$url" \
        | sed -E 's#[?#].*$##' \
        | sed -E 's#/(photo|video)/[0-9]+/?$##' \
        | sed -E 's#^https?://(www\.|mobile\.)?(twitter\.com|x\.com)/#https://api.fxtwitter.com/#')

    local media_urls
    media_urls=$(curl -sf --max-time 15 "$api_url" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    media = d.get("tweet", {}).get("media", {}) or {}
    for p in media.get("photos", []) or []:
        print(p["url"])
    for v in media.get("videos", []) or []:
        print(v["url"])
except Exception:
    sys.exit(1)
') || {
        echo "Error: failed to fetch tweet metadata from $api_url" >&2
        return 1
    }

    if [[ -z "$media_urls" ]]; then
        echo "Error: no media found in tweet" >&2
        return 1
    fi

    local count
    count=$(printf '%s\n' "$media_urls" | wc -l)

    local n=0 target
    while IFS= read -r media_url; do
        [[ -z "$media_url" ]] && continue
        n=$((n + 1))
        target="$name"
        # Multi-media tweets: suffix each file so they do not overwrite one another
        if [[ -n "$name" && $count -gt 1 ]]; then
            target="${name}_${n}"
        fi
        download_direct "$media_url" "" "$target"
    done <<< "$media_urls"
}

# Derive a filename from URL; synthesize extension from hint when URL basename has none
derive_filename() {
    local url="$1"
    local hint="${2:-}"  # mime type or extension

    local filename
    filename=$(basename "${url%%\?*}")

    if [[ -n "$filename" && "$filename" == *.* ]]; then
        echo "$filename"
        return
    fi

    local ext
    case "$hint" in
        image/jpeg|jpg|jpeg)  ext="jpg" ;;
        image/png|png)        ext="png" ;;
        image/gif|gif)        ext="gif" ;;
        image/webp|webp)      ext="webp" ;;
        image/svg+xml|svg)    ext="svg" ;;
        image/bmp|bmp)        ext="bmp" ;;
        application/pdf*|pdf) ext="pdf" ;;
        text/markdown*|text/x-markdown*|md|markdown) ext="md" ;;
        text/plain*|txt|text) ext="txt" ;;
        *) ext="bin" ;;
    esac
    echo "${filename:-download}.${ext}"
}

download_direct() {
    local url="$1"
    local hint="${2:-}"
    local name="${3:-}"
    local filename
    filename=$(derive_filename "$url" "$hint")
    # Keep the extension we derived, but swap in the requested stem
    if [[ -n "$name" ]]; then
        filename="${name}.${filename##*.}"
    fi
    curl -fLo "$staging/$filename" "$url"
    if install_staged "$staging/$filename" "$filename"; then
        echo "$filename"
    fi
}

# Fetch Content-Type via HEAD (following redirects); empty string on failure
head_content_type() {
    local url="$1"
    curl -sIL --max-time 10 -o /dev/null -w '%{content_type}' "$url" 2>/dev/null || true
}

# Try video download; on "No video could be found" (image-only post), fall back to image mode
download_platform() {
    local url="$1"
    local name="${2:-}"
    local errfile
    errfile=$(mktemp)

    local rc=0
    download_video "$url" "$name" 2> >(tee "$errfile" >&2) || rc=$?
    wait 2>/dev/null || true

    if [[ $rc -eq 0 ]]; then
        rm -f "$errfile"
        return 0
    fi

    # yt-dlp's default YouTube player clients (visionos/android_vr) sometimes hand
    # back media URLs that YouTube then refuses to serve (403). Extraction itself
    # worked, only the fetch was blocked, so retry with a client whose URLs still
    # are servable. Only when the caller did not pick its own extractor args.
    # Two spellings of the same 403 reach us: yt-dlp's own "HTTP Error 403:
    # Forbidden" from the native downloader, and "Server returned 403 Forbidden"
    # from ffmpeg on a -t cut (visible because download_video unmutes it). The
    # exit code is matched as well, but exactly: ffmpeg reports a 403 as
    # AVERROR_HTTP_FORBIDDEN, whose low byte is 8, so only code 8 means 403.
    # Matching any ffmpeg exit code here instead claimed a 403 for every failed
    # cut -- a section starting past the end of the video exits 222 -- which hid
    # the real reason behind a wrong message and a pointless second attempt.
    if [[ -z "$extractor_args" ]] \
        && [[ "$url" =~ ^https?://([a-z0-9-]+\.)*(youtube\.com|youtu\.be)/ ]] \
        && grep -qiE '403:? forbidden|ffmpeg exited with code 8($|[^0-9])' "$errfile"; then
        echo "-> YouTube returned 403 for the default player client, retrying with web_embedded..." >&2
        extractor_args="youtube:player_client=web_embedded"
        reset_staging
        rc=0
        download_video "$url" "$name" 2> >(tee "$errfile" >&2) || rc=$?
        wait 2>/dev/null || true
        if [[ $rc -eq 0 ]]; then
            rm -f "$errfile"
            return 0
        fi
    fi

    local has_no_video=0
    if grep -q "No video could be found" "$errfile"; then
        has_no_video=1
    fi
    # Reddit image posts fail differently: the extractor resolves the post, then
    # hands back a media redirect it cannot itself handle ("Unsupported URL:
    # https://www.reddit.com/media?url=..."), so treat that as "no video" too
    if [[ "$url" =~ ^https?://([a-z0-9-]+\.)*reddit\.com/ ]] && grep -q "Unsupported URL" "$errfile"; then
        has_no_video=1
    fi
    rm -f "$errfile"

    if [[ $has_no_video -eq 1 ]]; then
        reset_staging
        if [[ "$url" =~ (twitter\.com|x\.com)/ ]]; then
            echo "-> yt-dlp found no video, fetching media via fxtwitter API..." >&2
            download_twitter_media "$url" "$name"
        elif [[ "$url" =~ ^https?://([a-z0-9-]+\.)*reddit\.com/ ]]; then
            echo "-> No video in post, fetching image(s) from Reddit..." >&2
            download_reddit_images "$url" "$name"
        else
            echo "-> No video in post, downloading as image..." >&2
            download_platform_image "$url" "$name"
        fi
    else
        return $rc
    fi
}

# Reddit blocks plain HTTP clients at the TLS-fingerprint level (403 on every
# endpoint, including .json), so the post metadata is only reachable by a client
# that impersonates a real browser. yt-dlp does exactly that (via curl_cffi), and
# --write-pages makes it dump the post JSON its Reddit extractor already fetched.
# So we borrow yt-dlp purely as the impersonating fetcher and parse the media
# URLs ourselves. The images live on i.redd.it, which plain curl can reach.
reddit_image_urls() {
    local url="$1"
    local tmpdir rc=0
    tmpdir=$(mktemp -d)

    # yt-dlp itself bails on image posts ("Unsupported URL: .../media?url=..."),
    # but by then it has already fetched and dumped the JSON, which is all we need
    (cd "$tmpdir" && yt-dlp --write-pages --skip-download -J "$url" >/dev/null 2>&1) || true

    local dump
    dump=$(find "$tmpdir" -name '*.json.dump' -print -quit)
    if [[ -z "$dump" ]]; then
        rm -rf "$tmpdir"
        echo "Error: could not fetch Reddit post metadata for $url" >&2
        return 1
    fi

    python3 -c '
import sys, json
with open(sys.argv[1]) as f:
    data = json.load(f)
post = data[0]["data"]["children"][0]["data"]
urls = []
if post.get("is_gallery"):
    meta = post.get("media_metadata") or {}
    items = (post.get("gallery_data") or {}).get("items") or []
    # gallery_data preserves the order the poster arranged; media_metadata does not
    order = [i["media_id"] for i in items] or list(meta)
    for mid in order:
        s = (meta.get(mid) or {}).get("s") or {}
        u = s.get("u") or s.get("gif")
        if u:
            urls.append(u.replace("&amp;", "&"))
else:
    u = post.get("url_overridden_by_dest") or post.get("url")
    if u:
        urls.append(u)
for u in urls:
    print(u)
' "$dump" || rc=$?

    rm -rf "$tmpdir"
    return $rc
}

# Download every image in a Reddit post (single image or gallery)
download_reddit_images() {
    local url="$1"
    local name="${2:-}"

    local urls
    urls=$(reddit_image_urls "$url") || return 1
    if [[ -z "$urls" ]]; then
        echo "Error: no images found in Reddit post" >&2
        return 1
    fi

    local count
    count=$(printf '%s\n' "$urls" | wc -l)

    local n=0 target
    while IFS= read -r image_url; do
        [[ -z "$image_url" ]] && continue
        n=$((n + 1))
        target="$name"
        # Galleries: suffix each image so they do not overwrite one another
        if [[ -n "$name" && $count -gt 1 ]]; then
            target="${name}_${n}"
        fi
        download_direct "$image_url" "" "$target"
    done <<< "$urls"
}

dispatch() {
    local url="$1"
    local name="${2:-}"

    # Fast path: URL patterns (no network)
    if [[ "$url" =~ \.pdf(\?.*)?$ ]]; then
        download_direct "$url" "pdf" "$name"
        return
    fi
    if [[ "$url" =~ \.(txt|md|markdown)(\?.*)?$ ]]; then
        download_direct "$url" "${BASH_REMATCH[1]}" "$name"
        return
    fi
    if [[ "$url" =~ \.(jpg|jpeg|png|gif|webp|svg|bmp)(\?.*)?$ ]]; then
        download_direct "$url" "${BASH_REMATCH[1]}" "$name"
        return
    fi
    if [[ "$url" =~ [?\&]format=(jpg|jpeg|png|gif|webp) ]]; then
        download_direct "$url" "${BASH_REMATCH[1]}" "$name"
        return
    fi

    # HEAD check for proxy/CDN URLs without a usable path
    local ctype
    ctype=$(head_content_type "$url")
    case "$ctype" in
        image/*|application/pdf*|text/plain*|text/markdown*|text/x-markdown*)
            download_direct "$url" "$ctype" "$name"
            return
            ;;
    esac

    # Platform URL (Twitter, YouTube, etc.): try video, fall back to image
    download_platform "$url" "$name"
}

if [[ $# -eq 0 ]]; then
    print_usage
    exit 1
fi

output_name=""
timeframe=""
extractor_args=""
max_res=1080      # memes do not need 4K; --max lifts it to whatever exists
force=0
no_clobber=0
overwrite_all=0   # set by answering "a" to a prompt, for the rest of the run
staging=""
url=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) output_name="$2"; shift 2 ;;
        -t|--timeframe) timeframe="$2"; shift 2 ;;
        --max) max_res=""; shift ;;
        -f|--force) force=1; shift ;;
        -n|--no-clobber) no_clobber=1; shift ;;
        --extractor-args) extractor_args="$2"; shift 2 ;;
        -h|--help) print_usage; exit 0 ;;
        *) url="$1"; shift ;;
    esac
done

if [[ -z "$url" ]]; then
    print_usage
    exit 1
fi

if [[ $force -eq 1 && $no_clobber -eq 1 ]]; then
    echo "Error: -f and -n are mutually exclusive" >&2
    exit 1
fi

# Download into a staging dir and move each result into place afterwards, so the
# overwrite decision belongs to install_staged rather than to whichever backend
# ran. Staging sits in the destination directory so every install is a rename,
# and it starts empty, which is also what stops yt-dlp from silently skipping a
# download because the finished file from a previous run is already there.
staging=$(mktemp -d "./.dl-tmp.XXXXXX")
trap cleanup_staging INT TERM

rc=0
dispatch "$url" "$output_name" || rc=$?
cleanup_staging
exit $rc
