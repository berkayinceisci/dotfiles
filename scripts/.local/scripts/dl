#!/bin/bash
# dl - Download media from URLs (auto-detects video/image/PDF/text)
#
# Usage: dl <url>           Auto-detect and download
#        dl -o <name> <url> Download video with custom filename

set -euo pipefail

print_usage() {
    echo "Usage: dl <url>           Download (auto-detect video/image/PDF/text)"
    echo "       dl -o <name> <url> Download video with custom filename"
}

require_ytdlp() {
    if ! command -v yt-dlp >/dev/null 2>&1; then
        echo "Error: yt-dlp not found" >&2
        exit 1
    fi
}

download_video() {
    local url="$1"
    local name="${2:-}"
    require_ytdlp
    local -a extra_args=()
    if [[ -n "$name" ]]; then
        extra_args+=(--output "${name}.%(ext)s")
    fi
    local filepath rc=0
    filepath=$(yt-dlp --format "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]" -I 1 ${extra_args[@]+"${extra_args[@]}"} --print after_move:filepath "$url") || rc=$?
    if [[ $rc -ne 0 ]]; then
        return $rc
    fi
    echo "$filepath"
    if [[ -f "$filepath" ]]; then
        local size
        if [[ "$(uname -s)" == "Darwin" ]]; then
            size=$(stat -f%z "$filepath")
        else
            size=$(stat -c%s "$filepath")
        fi
        echo "Size: $(numfmt --to=iec "$size" 2>/dev/null || echo "${size} bytes")"
    fi
}

# yt-dlp fallback for platform image posts (Instagram image posts, etc.)
download_platform_image() {
    local url="$1"
    local name="${2:-}"
    require_ytdlp
    local -a extra_args=()
    if [[ -n "$name" ]]; then
        extra_args+=(--output "${name}.%(ext)s")
    fi
    yt-dlp ${extra_args[@]+"${extra_args[@]}"} --print after_move:filepath "$url"
}

# Twitter/X media posts: yt-dlp's twitter extractor now fails on many tweets
# (X requires auth), so use fxtwitter's public JSON API to extract media URLs
# (both photos and videos), then curl each one
download_twitter_media() {
    local url="$1"
    local api_url
    api_url=$(echo "$url" | sed -E 's#^https?://(www\.|mobile\.)?(twitter\.com|x\.com)/#https://api.fxtwitter.com/#')

    local media_urls
    media_urls=$(curl -sf --max-time 15 "$api_url" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    media = d.get("tweet", {}).get("media", {}) or {}
    for p in media.get("photos", []) or []:
        print(p["url"])
    for v in media.get("videos", []) or []:
        print(v["url"])
except Exception:
    sys.exit(1)
') || {
        echo "Error: failed to fetch tweet metadata from $api_url" >&2
        return 1
    }

    if [[ -z "$media_urls" ]]; then
        echo "Error: no media found in tweet" >&2
        return 1
    fi

    while IFS= read -r media_url; do
        [[ -z "$media_url" ]] && continue
        download_direct "$media_url" ""
    done <<< "$media_urls"
}

# Derive a filename from URL; synthesize extension from hint when URL basename has none
derive_filename() {
    local url="$1"
    local hint="${2:-}"  # mime type or extension

    local filename
    filename=$(basename "${url%%\?*}")

    if [[ -n "$filename" && "$filename" == *.* ]]; then
        echo "$filename"
        return
    fi

    local ext
    case "$hint" in
        image/jpeg|jpg|jpeg)  ext="jpg" ;;
        image/png|png)        ext="png" ;;
        image/gif|gif)        ext="gif" ;;
        image/webp|webp)      ext="webp" ;;
        image/svg+xml|svg)    ext="svg" ;;
        image/bmp|bmp)        ext="bmp" ;;
        application/pdf*|pdf) ext="pdf" ;;
        text/markdown*|text/x-markdown*|md|markdown) ext="md" ;;
        text/plain*|txt|text) ext="txt" ;;
        *) ext="bin" ;;
    esac
    echo "${filename:-download}.${ext}"
}

download_direct() {
    local url="$1"
    local hint="${2:-}"
    local name="${3:-}"
    local filename
    filename=$(derive_filename "$url" "$hint")
    # Keep the extension we derived, but swap in the requested stem
    if [[ -n "$name" ]]; then
        filename="${name}.${filename##*.}"
    fi
    curl -fLo "$filename" "$url"
    echo "$filename"
}

# Fetch Content-Type via HEAD (following redirects); empty string on failure
head_content_type() {
    local url="$1"
    curl -sIL --max-time 10 -o /dev/null -w '%{content_type}' "$url" 2>/dev/null || true
}

# Try video download; on "No video could be found" (image-only post), fall back to image mode
download_platform() {
    local url="$1"
    local name="${2:-}"
    local errfile
    errfile=$(mktemp)

    local rc=0
    download_video "$url" "$name" 2> >(tee "$errfile" >&2) || rc=$?
    wait 2>/dev/null || true

    if [[ $rc -eq 0 ]]; then
        rm -f "$errfile"
        return 0
    fi

    local has_no_video=0
    if grep -q "No video could be found" "$errfile"; then
        has_no_video=1
    fi
    # Reddit image posts fail differently: the extractor resolves the post, then
    # hands back a media redirect it cannot itself handle ("Unsupported URL:
    # https://www.reddit.com/media?url=..."), so treat that as "no video" too
    if [[ "$url" =~ ^https?://([a-z0-9-]+\.)*reddit\.com/ ]] && grep -q "Unsupported URL" "$errfile"; then
        has_no_video=1
    fi
    rm -f "$errfile"

    if [[ $has_no_video -eq 1 ]]; then
        if [[ "$url" =~ (twitter\.com|x\.com)/ ]]; then
            echo "-> yt-dlp found no video, fetching media via fxtwitter API..." >&2
            download_twitter_media "$url"
        elif [[ "$url" =~ ^https?://([a-z0-9-]+\.)*reddit\.com/ ]]; then
            echo "-> No video in post, fetching image(s) from Reddit..." >&2
            download_reddit_images "$url" "$name"
        else
            echo "-> No video in post, downloading as image..." >&2
            download_platform_image "$url" "$name"
        fi
    else
        return $rc
    fi
}

# Reddit blocks plain HTTP clients at the TLS-fingerprint level (403 on every
# endpoint, including .json), so the post metadata is only reachable by a client
# that impersonates a real browser. yt-dlp does exactly that (via curl_cffi), and
# --write-pages makes it dump the post JSON its Reddit extractor already fetched.
# So we borrow yt-dlp purely as the impersonating fetcher and parse the media
# URLs ourselves. The images live on i.redd.it, which plain curl can reach.
reddit_image_urls() {
    local url="$1"
    local tmpdir rc=0
    tmpdir=$(mktemp -d)

    # yt-dlp itself bails on image posts ("Unsupported URL: .../media?url=..."),
    # but by then it has already fetched and dumped the JSON, which is all we need
    (cd "$tmpdir" && yt-dlp --write-pages --skip-download -J "$url" >/dev/null 2>&1) || true

    local dump
    dump=$(find "$tmpdir" -name '*.json.dump' -print -quit)
    if [[ -z "$dump" ]]; then
        rm -rf "$tmpdir"
        echo "Error: could not fetch Reddit post metadata for $url" >&2
        return 1
    fi

    python3 -c '
import sys, json
with open(sys.argv[1]) as f:
    data = json.load(f)
post = data[0]["data"]["children"][0]["data"]
urls = []
if post.get("is_gallery"):
    meta = post.get("media_metadata") or {}
    items = (post.get("gallery_data") or {}).get("items") or []
    # gallery_data preserves the order the poster arranged; media_metadata does not
    order = [i["media_id"] for i in items] or list(meta)
    for mid in order:
        s = (meta.get(mid) or {}).get("s") or {}
        u = s.get("u") or s.get("gif")
        if u:
            urls.append(u.replace("&amp;", "&"))
else:
    u = post.get("url_overridden_by_dest") or post.get("url")
    if u:
        urls.append(u)
for u in urls:
    print(u)
' "$dump" || rc=$?

    rm -rf "$tmpdir"
    return $rc
}

# Download every image in a Reddit post (single image or gallery)
download_reddit_images() {
    local url="$1"
    local name="${2:-}"

    local urls
    urls=$(reddit_image_urls "$url") || return 1
    if [[ -z "$urls" ]]; then
        echo "Error: no images found in Reddit post" >&2
        return 1
    fi

    local count
    count=$(printf '%s\n' "$urls" | wc -l)

    local n=0 target
    while IFS= read -r image_url; do
        [[ -z "$image_url" ]] && continue
        n=$((n + 1))
        target="$name"
        # Galleries: suffix each image so they do not overwrite one another
        if [[ -n "$name" && $count -gt 1 ]]; then
            target="${name}_${n}"
        fi
        download_direct "$image_url" "" "$target"
    done <<< "$urls"
}

dispatch() {
    local url="$1"
    local name="${2:-}"

    # Fast path: URL patterns (no network)
    if [[ "$url" =~ \.pdf(\?.*)?$ ]]; then
        download_direct "$url" "pdf"
        return
    fi
    if [[ "$url" =~ \.(txt|md|markdown)(\?.*)?$ ]]; then
        download_direct "$url" "${BASH_REMATCH[1]}"
        return
    fi
    if [[ "$url" =~ \.(jpg|jpeg|png|gif|webp|svg|bmp)(\?.*)?$ ]]; then
        download_direct "$url" "${BASH_REMATCH[1]}"
        return
    fi
    if [[ "$url" =~ [?\&]format=(jpg|jpeg|png|gif|webp) ]]; then
        download_direct "$url" "${BASH_REMATCH[1]}"
        return
    fi

    # HEAD check for proxy/CDN URLs without a usable path
    local ctype
    ctype=$(head_content_type "$url")
    case "$ctype" in
        image/*|application/pdf*|text/plain*|text/markdown*|text/x-markdown*)
            download_direct "$url" "$ctype"
            return
            ;;
    esac

    # Platform URL (Twitter, YouTube, etc.): try video, fall back to image
    download_platform "$url" "$name"
}

if [[ $# -eq 0 ]]; then
    print_usage
    exit 1
fi

output_name=""
url=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) output_name="$2"; shift 2 ;;
        -h|--help) print_usage; exit 0 ;;
        *) url="$1"; shift ;;
    esac
done

if [[ -z "$url" ]]; then
    print_usage
    exit 1
fi

dispatch "$url" "$output_name"
