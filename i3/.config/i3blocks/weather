#!/bin/bash
CITY="Blacksburg"
# Open-Meteo takes coordinates, not a city name (these are Blacksburg, VA)
LAT="37.2296"
LON="-80.4139"
CACHE_FILE="/tmp/i3blocks_weather_cache"

get_desc() {
    # Map WMO weather codes (Open-Meteo's weather_code) to text for the
    # cache/display; get_emoji below matches on this text
    case "$1" in
        0) echo "Clear" ;;
        1|2) echo "Partly cloudy" ;;
        3) echo "Overcast" ;;
        45|48) echo "Fog" ;;
        51|53|55|56|57) echo "Drizzle" ;;
        61|63|65|66|67) echo "Rain" ;;
        71|73|75|77) echo "Snow" ;;
        80|81|82) echo "Rain showers" ;;
        85|86) echo "Snow showers" ;;
        95|96|99) echo "Thunderstorm" ;;
        *) echo "Unknown" ;;
    esac
}

get_emoji() {
    case "${1,,}" in
        *snow*|*blizzard*) echo "❄️" ;;
        *thunder*|*storm*) echo "⛈️" ;;
        *rain*|*drizzle*|*shower*) echo "🌧️" ;;
        *partly*|*partially*) echo "⛅" ;;
        *cloud*|*overcast*) echo "☁️" ;;
        *sun*|*clear*) echo "☀️" ;;
        *fog*|*mist*|*haze*) echo "🌫️" ;;
        *wind*) echo "💨" ;;
        *) echo "🌡️" ;;
    esac
}

# Output cached value immediately (non-blocking)
if [[ -f "$CACHE_FILE" ]]; then
    cached=$(cat "$CACHE_FILE")
    emoji=$(get_emoji "$cached")
    echo "$emoji $CITY: $cached"
else
    echo "🌡️ $CITY: ..."
fi

# Update cache in background for next run
(
    json=$(curl -s "https://api.open-meteo.com/v1/forecast?latitude=$LAT&longitude=$LON&current=temperature_2m,weather_code&temperature_unit=fahrenheit" --max-time 10)
    code=$(echo "$json" | jq -r '.current.weather_code' 2>/dev/null)
    temp=$(echo "$json" | jq -r '.current.temperature_2m | round' 2>/dev/null)
    if [[ -n "$code" && "$code" != "null" && -n "$temp" && "$temp" != "null" ]]; then
        echo "$(get_desc "$code") ${temp}°F" > "$CACHE_FILE"
    fi
) &
